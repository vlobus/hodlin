# Keep the build context small and host-agnostic: no local venv, VCS, tests,
# gitignored docs, or secrets should ever enter an image layer.
.git
.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.import_linter_cache
tests
docs
*.md
!README.md
.env
.env.*
!.env.example
.github
.claude
