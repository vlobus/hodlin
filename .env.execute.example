# Copy to .env.execute and fill in real values: `cp .env.execute.example .env.execute`
# .env.execute is gitignored — never commit real secrets.
#
# The EXECUTE domain's environment, deliberately a SEPARATE file from .env.
# The recommend domain's credentials must not appear here and these must not
# appear there: the EXECUTE_ prefix stops this process from *accidentally
# binding* the other domain's DATABASE_URL, but only the file split keeps the
# other domain's process from being handed these values at all (D34).

# --- Database (execute domain) ----------------------------------------------
# The execute domain's own database, reachable only by the hodlin_execute role
# (docker/postgres-init/10-domains.sql).
#
# Migrations read this variable from the ENVIRONMENT, not from this file: the
# Alembic env deliberately doesn't load a dotenv (it must run without the
# domain's other secrets), so exporting it is a step of its own —
#   set -a; . ./.env.execute; set +a
#   uv run --directory packages/execute alembic upgrade head
# Point it at the execute database or a throwaway one, never at the recommend
# database: the prefix stops the wrong variable being *bound*, not the right
# variable being aimed somewhere wrong.
EXECUTE_DATABASE_URL=postgresql+asyncpg://hodlin_execute:hodlin_execute@localhost:5432/hodlin_execute

# The token signing key, OIDC settings, and chain settings arrive with their own
# tasks (T13, T15, T17) and belong in this file too — never in .env.
